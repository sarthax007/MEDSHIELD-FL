# ---------------------------------------------------------------------------
# MedShield-FL — repository ignore rules
#
# Three categories are excluded on purpose:
#   1. Environments and build output  — reproducible from lockfiles
#   2. Datasets and model checkpoints — large, and MRI data must never be
#      committed even though BraTS is de-identified
#   3. Secrets and cryptographic keys — a leaked CKKS secret key would void
#      the entire privacy guarantee of this project
# ---------------------------------------------------------------------------

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
lib/
lib64/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version

# --- Testing / coverage / type checking -------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.dmypy.json
.ruff_cache/

# --- Node / frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Datasets ---------------------------------------------------------------
# Raw and derived medical imaging never enters version control.
data/raw/**
data/processed/**
data/partitions/**
*.nii
*.nii.gz
*.dcm
*.mha
*.npy
*.npz
*.h5
*.hdf5

# --- Model checkpoints and artifacts ----------------------------------------
data/checkpoints/**
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# --- Secrets and cryptographic material -------------------------------------
# .env holds the DB URL and JWT secret; *.key / *.ctx hold CKKS key material.
# The secret-key context MUST NOT leave the hospital that generated it.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.secret.ctx
secret_context*
keys/

# --- Experiment logs --------------------------------------------------------
runs/
logs/
wandb/
mlruns/
lightning_logs/
*.log

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Keep the directory skeleton --------------------------------------------
# The ignore rules above would otherwise erase these folders from a fresh
# clone, breaking the "clones cleanly with no missing-folder errors" contract.
!.gitkeep
!**/.gitkeep
