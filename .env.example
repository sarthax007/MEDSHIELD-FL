# ==============================================================================
# MedShield-FL — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit .env or any file containing real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database — PostgreSQL connection string
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://medshield:changeme@localhost:5432/medshield_db

# Sync URL for Alembic migrations (uses psycopg2)
DATABASE_URL_SYNC=postgresql+psycopg2://medshield:changeme@localhost:5432/medshield_db

# ------------------------------------------------------------------------------
# Backend security
# ------------------------------------------------------------------------------
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-hex-secret

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Flower federated-learning server
# ------------------------------------------------------------------------------
FL_SERVER_HOST=localhost
FL_SERVER_PORT=8080
FL_SERVER_ADDRESS=127.0.0.1:8080

# Number of federated rounds per training session
FL_NUM_ROUNDS=10

# Minimum clients that must connect before a round starts
FL_MIN_CLIENTS=2

# ------------------------------------------------------------------------------
# Homomorphic encryption — TenSEAL CKKS parameters
# These control the security / precision / performance trade-off.
# Do NOT change these after key generation without regenerating keys.
# ------------------------------------------------------------------------------
HE_POLY_MOD_DEGREE=8192
HE_COEFF_MOD_BIT_SIZES=60,40,40,60
HE_SCALE=2**40

# Path where the hospital client stores its CKKS secret-key context.
# Must be an absolute path inside the hospital environment.
# This path is NEVER shared with or reachable from the server.
HE_SECRET_CONTEXT_PATH=./keys/secret.ctx

# Path for the CKKS public context (safe to share with the server).
HE_PUBLIC_CONTEXT_PATH=./keys/public.ctx

# ------------------------------------------------------------------------------
# Application behaviour
# ------------------------------------------------------------------------------
# "development" | "production"
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Data paths (override defaults for different machines / clusters)
# ------------------------------------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_PARTITIONS_DIR=./data/partitions
DATA_CHECKPOINTS_DIR=./data/checkpoints
